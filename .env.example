# Copy this file to .env and set a unique SECRET_KEY before using the app.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
DATABASE_URL=sqlite:///./desifit.db
BACKEND_API_URL=http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email Configuration (SMTP) for Password Recovery
# In local development, leave SMTP_HOST blank to test via local dev reset links
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@desifit.com
FRONTEND_URL=http://localhost:8501
